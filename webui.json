{
  "schema_version": 2,
  "required_capabilities": [
    "declarative_basic"
  ],
  "workspace_title": "Mai Persona",
  "pages": [
    {
      "id": "overview",
      "title": "运行概览",
      "placement": "workspace",
      "mode": "declarative",
      "icon": "chart",
      "description": "查看 Mai Persona 维护的生活状态、事件线、关系与日记。",
      "queries": {
        "snapshot": {
          "api": "webui_snapshot",
          "version": "1"
        }
      },
      "auto_refresh": true,
      "poll_interval_seconds": 30,
      "content": [
        {
          "type": "grid",
          "columns": 4,
          "children": [
            {
              "type": "stat",
              "label": "运行状态",
              "value": {
                "source": "snapshot",
                "field": "status"
              }
            },
            {
              "type": "stat",
              "label": "当前心境",
              "value": {
                "source": "snapshot",
                "field": "mood_label"
              }
            },
            {
              "type": "stat",
              "label": "即时情绪",
              "value": {
                "source": "snapshot",
                "field": "emotion_label"
              }
            },
            {
              "type": "stat",
              "label": "活跃事件线",
              "value": {
                "source": "snapshot",
                "field": "event_count"
              }
            }
          ]
        },
        {
          "type": "grid",
          "columns": 4,
          "children": [
            {
              "type": "stat",
              "label": "表达能量",
              "value": {
                "source": "snapshot",
                "field": "humanlike_energy"
              }
            },
            {
              "type": "stat",
              "label": "待跟进",
              "value": {
                "source": "snapshot",
                "field": "humanlike_followups"
              }
            },
            {
              "type": "stat",
              "label": "谈话边界",
              "value": {
                "source": "snapshot",
                "field": "humanlike_boundaries"
              }
            },
            {
              "type": "stat",
              "label": "未化解不快",
              "value": {
                "source": "snapshot",
                "field": "humanlike_grudge"
              }
            }
          ]
        },
        {
          "type": "grid",
          "columns": 2,
          "children": [
            {
              "type": "text",
              "label": "修复提示",
              "value": {
                "source": "snapshot",
                "field": "humanlike_repairs"
              }
            },
            {
              "type": "text",
              "label": "缺席状态",
              "value": {
                "source": "snapshot",
                "field": "humanlike_absence"
              }
            }
          ]
        },
        {
          "type": "text",
          "label": "对方说话长度",
          "value": {
            "source": "snapshot",
            "field": "humanlike_style"
          }
        },
        {
          "type": "grid",
          "columns": 2,
          "children": [
            {
              "type": "text",
              "label": "共同记忆峰值",
              "value": {
                "source": "snapshot",
                "field": "humanlike_peaks"
              }
            },
            {
              "type": "text",
              "label": "下一条跟进",
              "value": {
                "source": "snapshot",
                "field": "humanlike_next_followup"
              }
            }
          ]
        },
        {
          "type": "text",
          "label": "今日提示采纳（用于/注入）",
          "value": {
            "source": "snapshot",
            "field": "humanlike_hint_stats"
          }
        },
        {
          "type": "grid",
          "columns": 3,
          "children": [
            {"type": "text", "label": "对方回复节奏", "value": {"source": "snapshot", "field": "humanlike_rhythm"}},
            {"type": "text", "label": "开放话题", "value": {"source": "snapshot", "field": "humanlike_threads"}},
            {"type": "text", "label": "固定时段", "value": {"source": "snapshot", "field": "humanlike_rituals"}}
          ]
        },
        {
          "type": "grid",
          "columns": 3,
          "children": [
            {"type": "text", "label": "倾诉状态", "value": {"source": "snapshot", "field": "humanlike_support"}},
            {"type": "text", "label": "认识天数提醒", "value": {"source": "snapshot", "field": "humanlike_milestone"}},
            {"type": "text", "label": "分享次数（对方/角色）", "value": {"source": "snapshot", "field": "humanlike_disclosure"}}
          ]
        },
        {
          "type": "grid",
          "columns": 3,
          "children": [
            {
              "type": "stat",
              "label": "心境 P",
              "value": {
                "source": "snapshot",
                "field": "mood.p"
              }
            },
            {
              "type": "stat",
              "label": "心境 A",
              "value": {
                "source": "snapshot",
                "field": "mood.a"
              }
            },
            {
              "type": "stat",
              "label": "心境 D",
              "value": {
                "source": "snapshot",
                "field": "mood.d"
              }
            },
            {
              "type": "stat",
              "label": "即时情绪 P",
              "value": {
                "source": "snapshot",
                "field": "emotion.p"
              }
            },
            {
              "type": "stat",
              "label": "即时情绪 A",
              "value": {
                "source": "snapshot",
                "field": "emotion.a"
              }
            },
            {
              "type": "stat",
              "label": "即时情绪 D",
              "value": {
                "source": "snapshot",
                "field": "emotion.d"
              }
            }
          ]
        },
        {
          "type": "text",
          "label": "当前安排",
          "value": {
            "source": "snapshot",
            "field": "activity"
          }
        },
        {
          "type": "text",
          "label": "日程来源",
          "value": {
            "source": "snapshot",
            "field": "activity_source"
          }
        },
        {
          "type": "text",
          "label": "日程连接状态",
          "value": {
            "source": "snapshot",
            "field": "schedule_status"
          }
        },
        {
          "type": "text",
          "label": "今日活动概览",
          "value": {
            "source": "snapshot",
            "field": "schedule_context"
          }
        },
        {
          "type": "text",
          "label": "状态更新时间",
          "value": {
            "source": "snapshot",
            "field": "updated_at"
          }
        },
        {
          "type": "tabs",
          "children": [
            {
              "type": "stack",
              "label": "事件线",
              "children": [
                {
                  "type": "table",
                  "label": "活跃事件",
                  "value": {
                    "source": "snapshot",
                    "field": "event_lines"
                  },
                  "columns": [
                    {
                      "field": "title",
                      "label": "标题"
                    },
                    {
                      "field": "stage",
                      "label": "阶段"
                    },
                    {
                      "field": "content",
                      "label": "进展"
                    },
                    {
                      "field": "talkable",
                      "label": "提及倾向"
                    },
                    {
                      "field": "started_at",
                      "label": "开始时间"
                    }
                  ]
                }
              ]
            },
            {
              "type": "stack",
              "label": "日记",
              "children": [
                {
                  "type": "table",
                  "label": "近期日记",
                  "value": {
                    "source": "snapshot",
                    "field": "diaries"
                  },
                  "columns": [
                    {
                      "field": "date",
                      "label": "日期"
                    },
                    {
                      "field": "preview",
                      "label": "内容"
                    },
                    {
                      "field": "created_at",
                      "label": "生成时间"
                    }
                  ],
                  "selection": "selected_diary",
                  "detail": "diary_details"
                }
              ]
            },
            {
              "type": "stack",
              "label": "关系与好感",
              "children": [
                {
                  "type": "stat",
                  "label": "关系记录",
                  "value": {
                    "source": "snapshot",
                    "field": "relationship_count"
                  }
                },
                {
                  "type": "table",
                  "label": "用户关系",
                  "value": {
                    "source": "snapshot",
                    "field": "relationships"
                  },
                  "columns": [
                    {
                      "field": "user_id",
                      "label": "用户 ID"
                    },
                    {
                      "field": "stage",
                      "label": "关系阶段"
                    },
                    {
                      "field": "trust",
                      "label": "信任"
                    },
                    {
                      "field": "intimacy",
                      "label": "亲密"
                    },
                    {
                      "field": "rapport",
                      "label": "默契"
                    },
                    {
                      "field": "updated_at",
                      "label": "更新时间"
                    }
                  ]
                }
              ]
            },
            {
              "type": "stack",
              "label": "待办",
              "children": [
                {
                  "type": "stat",
                  "label": "未完成待办",
                  "value": {
                    "source": "snapshot",
                    "field": "todo_count"
                  }
                },
                {
                  "type": "table",
                  "label": "待办事项",
                  "value": {
                    "source": "snapshot",
                    "field": "todos"
                  },
                  "columns": [
                    {
                      "field": "user_id",
                      "label": "用户 ID"
                    },
                    {
                      "field": "content",
                      "label": "事项"
                    },
                    {
                      "field": "due",
                      "label": "期限"
                    },
                    {
                      "field": "created_at",
                      "label": "记录时间"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "dialog",
          "name": "diary_details",
          "label": "日记正文",
          "children": [
            {
              "type": "text",
              "value": {
                "scope": "selection",
                "source": "selected_diary",
                "field": "content"
              },
              "format": "log"
            }
          ]
        }
      ]
    },
    {
      "id": "setup",
      "title": "配置向导",
      "placement": "sidebar",
      "mode": "declarative",
      "icon": "settings",
      "description": "按步骤检查配置，并生成可直接粘贴到 config.toml 的片段。",
      "queries": {
        "setup": {
          "api": "webui_setup_status",
          "version": "1"
        },
        "preview": {
          "api": "webui_config_preview",
          "version": "1"
        }
      },
      "actions": {
        "compose": {
          "api": "webui_compose_config",
          "version": "1",
          "parameters": {
            "name": {
              "type": "string",
              "required": false,
              "max_length": 80
            },
            "viewpoint": {
              "type": "string",
              "required": false,
              "max_length": 2000
            },
            "goals": {
              "type": "string",
              "required": false,
              "max_length": 2000
            },
            "stages": {
              "type": "string",
              "required": false,
              "max_length": 500
            },
            "event_domains": {
              "type": "string",
              "required": false,
              "max_length": 500
            },
            "micro_domains": {
              "type": "string",
              "required": false,
              "max_length": 500
            },
            "daily_limit": {
              "type": "string",
              "required": false,
              "max_length": 8
            },
            "proactive": {
              "type": "string",
              "required": false,
              "choices": ["keep", "on", "off"]
            }
          }
        }
      },
      "auto_refresh": true,
      "poll_interval_seconds": 30,
      "content": [
        {
          "type": "grid",
          "columns": 2,
          "children": [
            {
              "type": "stat",
              "label": "配置完成度",
              "value": {
                "source": "setup",
                "field": "summary"
              }
            },
            {
              "type": "stat",
              "label": "当前状态",
              "value": {
                "source": "setup",
                "field": "ready"
              }
            }
          ]
        },
        {
          "type": "progress",
          "label": "完成进度",
          "value": {
            "source": "setup",
            "field": "completion"
          }
        },
        {
          "type": "text",
          "label": "下一步",
          "value": {
            "source": "setup",
            "field": "next_step"
          }
        },
        {
          "type": "collapsible",
          "label": "第 1 步 · 角色资料与生活领域",
          "default_open": true,
          "children": [
            {
              "type": "text",
              "value": {
                "source": "setup",
                "field": "steps_persona"
              },
              "format": "plain"
            },
            {
              "type": "text",
              "value": "角色称呼只用于标记插件维护的状态，建议与 MaiBot 人格使用同一称呼；状态评价视角写判断依据；长期生活方向用于模拟日常，不是每轮对话都要讲的目标。",
              "format": "plain"
            }
          ]
        },
        {
          "type": "collapsible",
          "label": "第 2 步 · 主动联系（可选）",
          "default_open": false,
          "children": [
            {
              "type": "text",
              "value": {
                "source": "setup",
                "field": "steps_proactive"
              },
              "format": "plain"
            },
            {
              "type": "text",
              "value": "主动联系默认关闭。开启后仍受最小间隔、每日上限和静默时段约束；“私聊结束后由 Planner 决定下次联系时间”需要单独开启。",
              "format": "plain"
            }
          ]
        },
        {
          "type": "card",
          "label": "第 3 步 · 生成配置片段",
          "children": [
            {
              "type": "text",
              "value": "填写需要修改的项，留空表示保持原值。多个值用顿号、逗号或换行分隔。生成结果只包含你填写的字段，粘贴到 config.toml 后重载插件即可生效。",
              "format": "plain"
            },
            {
              "type": "input",
              "name": "name",
              "label": "角色称呼",
              "value": ""
            },
            {
              "type": "input",
              "name": "viewpoint",
              "label": "状态评价视角（可多条）",
              "value": ""
            },
            {
              "type": "input",
              "name": "goals",
              "label": "长期生活方向",
              "value": ""
            },
            {
              "type": "input",
              "name": "stages",
              "label": "关系阶段（由浅到深）",
              "value": ""
            },
            {
              "type": "input",
              "name": "event_domains",
              "label": "长期事件线领域",
              "value": ""
            },
            {
              "type": "input",
              "name": "micro_domains",
              "label": "日常小事领域",
              "value": ""
            },
            {
              "type": "input",
              "name": "daily_limit",
              "label": "每日主动联系上限（0-100）",
              "value": ""
            },
            {
              "type": "select",
              "name": "proactive",
              "label": "允许主动联系",
              "value": "keep",
              "options": [
                {
                  "label": "保持不变",
                  "value": "keep"
                },
                {
                  "label": "开启",
                  "value": "on"
                },
                {
                  "label": "关闭",
                  "value": "off"
                }
              ]
            },
            {
              "type": "button",
              "label": "生成配置片段",
              "action": "compose",
              "variant": "primary"
            }
          ]
        },
        {
          "type": "card",
          "label": "生成结果",
          "children": [
            {
              "type": "text",
              "value": {
                "source": "preview",
                "field": "status"
              },
              "format": "plain"
            },
            {
              "type": "text",
              "value": {
                "source": "preview",
                "field": "body"
              },
              "format": "log"
            }
          ]
        }
      ]
    },
    {
      "id": "tuning",
      "title": "拟人设置",
      "placement": "sidebar",
      "mode": "declarative",
      "icon": "list",
      "description": "调整拟人细节的幅度与节奏；生成片段后粘贴到 config.toml。",
      "queries": {
        "preview": {
          "api": "webui_config_preview",
          "version": "1"
        }
      },
      "actions": {
        "compose": {
          "api": "webui_compose_config",
          "version": "1",
          "parameters": {
            "rhythm_factor": {"type": "string", "required": false, "max_length": 8},
            "followup_extract_hours": {"type": "string", "required": false, "max_length": 8},
            "style_min_samples": {"type": "string", "required": false, "max_length": 8},
            "absence_dip": {"type": "string", "required": false, "max_length": 8},
            "reunion_boost": {"type": "string", "required": false, "max_length": 8},
            "grudge_cap": {"type": "string", "required": false, "max_length": 8},
            "energy_tau_hours": {"type": "string", "required": false, "max_length": 8},
            "support_turns": {"type": "string", "required": false, "max_length": 8},
            "ritual_min_days": {"type": "string", "required": false, "max_length": 8},
            "thread_ttl_days": {"type": "string", "required": false, "max_length": 8},
            "milestone_every_days": {"type": "string", "required": false, "max_length": 8},
            "reciprocity_gap": {"type": "string", "required": false, "max_length": 8}
          }
        }
      },
      "content": [
        {
          "type": "text",
          "value": "只填想改的项，留空表示保持原值。数字单位见说明；生成后粘贴到 config.toml 的对应段落并重载插件。",
          "format": "plain"
        },
        {
          "type": "collapsible",
          "label": "节奏与风格",
          "default_open": true,
          "children": [
            {"type": "input", "name": "rhythm_factor", "label": "沉默阈值倍数（1-20，默认 3）", "value": ""},
            {"type": "input", "name": "followup_extract_hours", "label": "跟进整理间隔（小时，默认 6）", "value": ""},
            {"type": "input", "name": "style_min_samples", "label": "风格样本下限（默认 20）", "value": ""}
          ]
        },
        {
          "type": "collapsible",
          "label": "情绪与关系幅度",
          "default_open": false,
          "children": [
            {"type": "input", "name": "absence_dip", "label": "缺席失落幅度（0-0.3，默认 0.06）", "value": ""},
            {"type": "input", "name": "reunion_boost", "label": "重逢回升幅度（0-0.3，默认 0.08）", "value": ""},
            {"type": "input", "name": "grudge_cap", "label": "遗怨上限（0-1，默认 0.3）", "value": ""},
            {"type": "input", "name": "energy_tau_hours", "label": "能量恢复时间（小时，默认 8）", "value": ""}
          ]
        },
        {
          "type": "collapsible",
          "label": "互动细节",
          "default_open": false,
          "children": [
            {"type": "input", "name": "support_turns", "label": "倾诉持续条数（默认 2）", "value": ""},
            {"type": "input", "name": "ritual_min_days", "label": "固定时段最少天数（默认 5）", "value": ""},
            {"type": "input", "name": "thread_ttl_days", "label": "开放话题保留天数（默认 14）", "value": ""},
            {"type": "input", "name": "milestone_every_days", "label": "里程碑间隔（天，默认 30）", "value": ""},
            {"type": "input", "name": "reciprocity_gap", "label": "分享次数差阈值（默认 3）", "value": ""}
          ]
        },
        {
          "type": "button",
          "label": "生成配置片段",
          "action": "compose",
          "variant": "primary"
        },
        {
          "type": "card",
          "label": "生成结果",
          "children": [
            {"type": "text", "value": {"source": "preview", "field": "status"}, "format": "plain"},
            {"type": "text", "value": {"source": "preview", "field": "body"}, "format": "log"}
          ]
        }
      ]
    }
  ]
}
